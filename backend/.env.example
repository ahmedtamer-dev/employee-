# منفذ الـ API
PORT=4000

# سر توقيع JWT (غيّره في الإنتاج)
JWT_SECRET=nasaq-super-secret-change-me
JWT_EXPIRES_IN=12h

# أصل الواجهة المسموح به (CORS) - مفصول بفاصلة لو أكثر من واحد
CORS_ORIGIN=http://localhost:5173

# مسار ملف قاعدة البيانات (نسبة إلى مجلد backend)
DB_FILE=data/db.json

NODE_ENV=development
